# Copy to .env.local for local dev. Never commit real values.
# Production values live in Vercel project env vars (Production only, sensitive).

# Base URL of the OrbitDesk deployment, e.g. https://orbitdesk.dejoiy.com
ORBITDESK_BASE_URL=

# Service account used by the magistick server proxy to call OrbitDesk's API.
# Create this user inside OrbitDesk (Settings → Users) with ticket-create rights.
ORBITDESK_SERVICE_EMAIL=
ORBITDESK_SERVICE_PASSWORD=
